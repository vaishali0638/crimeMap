    {
      "type": "timeseries",
      "title": "Map filter p95 / p50 (target 500 ms)",
      "datasource": {
        "type": "prometheus",
        "uid": "crimemap-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(crimemap_http_request_duration_seconds_bucket{route=\"/api/v1/map/features\"}[5m])))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "crimemap-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(crimemap_http_request_duration_seconds_bucket{route=\"/api/v1/map/features\"}[5m])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
