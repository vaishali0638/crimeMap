# CRIMEMAP local configuration — PLACEHOLDERS ONLY. Never put real values in this file.
# Create your local .env (git-ignored) with generated secrets:   scripts/dev_bootstrap.sh
# Production secrets come from a secrets manager, never from files.

CRIMEMAP_ENVIRONMENT=DEMO

# PostgreSQL (superuser is used only by the container's first-run init script)
POSTGRES_SUPERUSER_PASSWORD=change-me
CRIMEMAP_DB_NAME=crimemap
CRIMEMAP_MIGRATOR_PASSWORD=change-me
CRIMEMAP_APP_PASSWORD=change-me
CRIMEMAP_WORKER_PASSWORD=change-me
CRIMEMAP_AI_PASSWORD=change-me

# Redis (rate limiting, sessions, job broker)
REDIS_PASSWORD=change-me

# Keycloak (development identity provider)
KEYCLOAK_ADMIN_PASSWORD=change-me
CRIMEMAP_KC_WEB_CLIENT_SECRET=change-me
CRIMEMAP_KC_AUDIT_SYNC_SECRET=change-me
CRIMEMAP_DEMO_PASSWORD=change-me

# S3-compatible object storage (SeaweedFS in development)
CRIMEMAP_S3_ACCESS_KEY=change-me
CRIMEMAP_S3_SECRET_KEY=change-me

# Signs synthetic demo batch files (HMAC-SHA256); the worker verifies before staging anything
CRIMEMAP_DEMO_SIGNING_KEY=change-me

# Bearer token Prometheus uses to scrape the API's /metrics (unset or empty: /metrics answers 404)
CRIMEMAP_METRICS_TOKEN=change-me

# Encrypts database backups (scripts/backup.sh); keep a copy in the offline key escrow (runbook)
CRIMEMAP_BACKUP_PASSPHRASE=change-me

# Web BFF: 32-byte key (base64) encrypting server-side session data
CRIMEMAP_SESSION_KEY=change-me

# Host ports (defaults avoid a host PostgreSQL on 5432 / Redis on 6379 / dev server on 3000)
CRIMEMAP_PG_HOST_PORT=55432
CRIMEMAP_REDIS_HOST_PORT=56379
CRIMEMAP_WEB_BASE_URL=http://localhost:3100
CRIMEMAP_API_INTERNAL_URL=http://localhost:8000
CRIMEMAP_OIDC_ISSUER=http://localhost:8080/realms/crimemap-demo
# Web BFF session store (Redis db 2); bootstrap fills in the password
CRIMEMAP_REDIS_URL=redis://:change-me@localhost:56379/2
# Optional approved basemap style (MapLibre style JSON). Empty = no basemap, no third-party requests
# (ADR-033). Its origin is added to the web CSP when set.
CRIMEMAP_MAP_STYLE_URL=
# Optional, comma-separated bare https origins the style loads tiles/glyphs/sprites from. An invalid
# style URL or origin turns the basemap off rather than failing pages.
CRIMEMAP_MAP_ASSET_ORIGINS=
